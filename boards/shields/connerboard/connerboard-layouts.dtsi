// See https://zmk.dev/docs/development/hardware-integration/physical-layouts
// for how to configure this.

#include <physical_layouts.dtsi>

/ {
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan>;

        // Edit this to define the positions and sizes of the keys, or remove it
        // if your keyboard will not support ZMK Studio.
        // https://zmk.dev/docs/development/hardware-integration/physical-layouts#optional-keys-property
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100  500    0       0     0     0>
            , <&key_physical_attrs 100 100  900    0       0     0     0>
            , <&key_physical_attrs 100 100 1000    0       0     0     0>
            , <&key_physical_attrs 100 100 1100    0       0     0     0>
            , <&key_physical_attrs 100 100 1200    0       0     0     0>
            , <&key_physical_attrs 100 100 1300    0       0     0     0>
            , <&key_physical_attrs 100 100 1400    0       0     0     0>
            , <&key_physical_attrs 100 100 1500    0       0     0     0>
            , <&key_physical_attrs 100 100 1675    0       0     0     0>
            , <&key_physical_attrs 100 100    0    100     0     0     0>
            , <&key_physical_attrs 100 100  100    100     0     0     0>
            , <&key_physical_attrs 100 100  200    100     0     0     0>
            , <&key_physical_attrs 100 100  300    100     0     0     0>
            , <&key_physical_attrs 100 100  400    100     0     0     0>
            , <&key_physical_attrs 100 100  900    100     0     0     0>
            , <&key_physical_attrs 100 100 1000    100     0     0     0>
            , <&key_physical_attrs 100 100 1100    100     0     0     0>
            , <&key_physical_attrs 100 100 1200    100     0     0     0>
            , <&key_physical_attrs 100 100 1300    100     0     0     0>
            , <&key_physical_attrs 100 100 1400    100     0     0     0>
            , <&key_physical_attrs 100 100 1500    100     0     0     0>
            , <&key_physical_attrs 175 100 1600    100     0     0     0>
            , <&key_physical_attrs 125 100    0    200     0     0     0>
            , <&key_physical_attrs 100 100  125    200     0     0     0>
            , <&key_physical_attrs 100 100  225    200     0     0     0>
            , <&key_physical_attrs 100 100  325    200     0     0     0>
            , <&key_physical_attrs 100 100  425    200     0     0     0>
            , <&key_physical_attrs 100 100  525    200     0     0     0>
            , <&key_physical_attrs 100 100  925    200     0     0     0>
            , <&key_physical_attrs 100 100 1025    200     0     0     0>
            , <&key_physical_attrs 100 100 1125    200     0     0     0>
            , <&key_physical_attrs 100 100 1225    200     0     0     0>
            , <&key_physical_attrs 100 100 1325    200     0     0     0>
            , <&key_physical_attrs 100 100 1425    200     0     0     0>
            , <&key_physical_attrs 100 100 1525    200     0     0     0>
            , <&key_physical_attrs 150 100 1625    200     0     0     0>
            , <&key_physical_attrs 150 100    0    300     0     0     0>
            , <&key_physical_attrs 100 100  150    300     0     0     0>
            , <&key_physical_attrs 100 100  250    300     0     0     0>
            , <&key_physical_attrs 100 100  350    300     0     0     0>
            , <&key_physical_attrs 100 100  450    300     0     0     0>
            , <&key_physical_attrs 100 100  550    300     0     0     0>
            , <&key_physical_attrs 100 100  950    300     0     0     0>
            , <&key_physical_attrs 100 100 1050    300     0     0     0>
            , <&key_physical_attrs 100 100 1150    300     0     0     0>
            , <&key_physical_attrs 100 100 1250    300     0     0     0>
            , <&key_physical_attrs 100 100 1350    300     0     0     0>
            , <&key_physical_attrs 100 100 1450    300     0     0     0>
            , <&key_physical_attrs 100 100 1550    300     0     0     0>
            , <&key_physical_attrs 125 100 1650    300     0     0     0>
            , <&key_physical_attrs 175 100    0    400     0     0     0>
            , <&key_physical_attrs 100 100  175    400     0     0     0>
            , <&key_physical_attrs 100 100  275    400     0     0     0>
            , <&key_physical_attrs 100 100  375    400     0     0     0>
            , <&key_physical_attrs 100 100  475    400     0     0     0>
            , <&key_physical_attrs 100 100  575    400     0     0     0>
            , <&key_physical_attrs 100 100  975    400     0     0     0>
            , <&key_physical_attrs 100 100 1075    400     0     0     0>
            , <&key_physical_attrs 100 100 1175    400     0     0     0>
            , <&key_physical_attrs 100 100 1275    400     0     0     0>
            , <&key_physical_attrs 100 100 1375    400     0     0     0>
            , <&key_physical_attrs 100 100 1475    400     0     0     0>
            , <&key_physical_attrs 100 100 1575    400     0     0     0>
            , <&key_physical_attrs 100 100 1675    400     0     0     0>
            , <&key_physical_attrs 100 100  300    500     0     0     0>
            , <&key_physical_attrs 100 100  400    500     0     0     0>
            , <&key_physical_attrs 175 100  500    500     0     0     0>
            , <&key_physical_attrs 175 100  975    500     0     0     0>
            , <&key_physical_attrs 100 100 1150    500     0     0     0>
            , <&key_physical_attrs 100 100 1250    500     0     0     0>
            , <&key_physical_attrs 100 100 1350    500     0     0     0>
            ;
    };
};
